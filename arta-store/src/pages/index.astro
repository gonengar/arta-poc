---
import Layout from '../layouts/Layout.astro';
import { ProductCard } from '../components/StoreUI';
import { navigation, featured, settings } from '../lib/catalog';
let nodes:any[]=[],products:any[]=[],config:any={};let error=false;
try{[nodes,products,config]=await Promise.all([navigation(),featured(),settings()])}catch{error=true}
const roots=nodes.filter(n=>!n.parentKey);const tiles=roots.filter(n=>n.image).slice(0,5);
const heroImages=products.filter(p=>p.image).slice(0,2);
---
<Layout nodes={nodes} config={config}><section class="hero"><div class="hero-copy"><span class="eyebrow">ארטא · חומרים לאמנות וליצירה</span><h1>כל יצירה מתחילה<br/><em>בחומר הנכון</em></h1><p>{config.subtitle||'צבעים, ניירות וכלי אמנות — מהסקיצה הראשונה ועד העבודה הבאה.'}</p><a class="button" href="/shop">לגלות את הקטלוג <span aria-hidden="true">←</span></a></div><div class="hero-art"><span class="hero-art-label">מקום לרעיונות שלכם</span>{heroImages.map((p,i)=><img class={'hero-object '+(i?'secondary':'primary')} src={p.image} alt={p.name} loading="eager"/>)}<a href={heroImages[0]?'/product/'+heroImages[0].slug:'/shop'} class="hero-art-note"><div><strong>מהדמיון, אל הדף</strong><span>לגלות את החומרים</span></div><span aria-hidden="true">↖</span></a></div></section><div class="manifesto-strip"><span><i/>חומרים לכל טכניקה</span><span><i/>מותגי אמנות מכל העולם</span><span><i/>מהסקיצה הראשונה ועד העבודה הבאה</span></div><section class="section"><div class="section-heading"><div><span class="eyebrow">לכל רעיון, הדרך שלו</span><h2>מה יוצרים היום?</h2></div><a href="/shop">לכל הקטגוריות <span aria-hidden="true">←</span></a></div><div class="category-grid">{tiles.map(n=><a class="category-tile" href={'/category/'+n.storeSlug}><div class="tile-image">{n.image&&<img src={n.image} alt={n.name} loading="lazy"/>}</div><h3>{n.name}<span aria-hidden="true">↖</span></h3><p>לגלות את החומרים והאפשרויות</p></a>)}</div>{error&&<p class="error-state">לא ניתן לטעון את הקטלוג כרגע. <a href="/shop">לנסות שוב</a></p>}</section><section class="section feature-section"><div class="section-heading"><div><span class="eyebrow">מהקטלוג של ארטא</span><h2>חומרים שמזמינים להתחיל</h2></div><a href="/shop">להמשך הקטלוג <span aria-hidden="true">←</span></a></div><div class="product-grid">{products.slice(0,4).map(p=><ProductCard product={p} client:load/>)}</div></section><section class="editorial"><div><span class="eyebrow">להתנסות. לערבב. ליצור.</span><h2>לא צריך לדעת<br/>איך זה ייגמר.<br/>רק מאיפה להתחיל.</h2></div><div><p>דף לבן, גוון שעוד לא ניסיתם, מכחול שמרגיש נכון ביד. לפעמים חומר אחד הוא כל מה שצריך בשביל רעיון חדש.</p><a href="/shop">למצוא את החומר הבא שלכם <span aria-hidden="true">←</span></a></div></section><div class="brand-row" dir="ltr">{Array.from(new Set(products.map(p=>p.brand).filter(Boolean))).slice(0,5).map(b=><a href={'/shop?brand='+encodeURIComponent(b)}>{b}</a>)}</div></Layout>
